+            victim_profile     VARCHAR(150)  NULL COMMENT 'never a private name',
+            loss_amount        DECIMAL(16,2) NULL,
+            currency           CHAR(3)       NULL,
+            loss_usd_approx    DECIMAL(16,2) NULL,
