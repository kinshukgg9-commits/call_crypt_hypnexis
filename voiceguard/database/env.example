# Copy into your environment (Render > Environment, or a local .env). Storage is off without DATABASE_URL.
DATABASE_URL=mysql://voiceguard:CHANGE_ME@your-mysql-host:3306/voiceguard?ssl=true
STORAGE_ADMIN_TOKEN=a-long-random-string

# Lifecycle (these are the defaults)
DB_RECENT_ROWS=300
DB_RECENT_DAYS=5
DB_MAX_ROWS=600
DB_ARCHIVE_RESET_DAYS=5
DB_TRASH_AFTER_DAYS=10
DB_TRASH_RETENTION_DAYS=10
DB_MAX_TRASH_ROWS=600
DB_MAINTENANCE_SECONDS=300

# Writing
DB_QUEUE_SIZE=500
DB_BATCH_SIZE=50
DB_CONNECT_TIMEOUT=5
DB_STORE_TRANSCRIPTS=false
