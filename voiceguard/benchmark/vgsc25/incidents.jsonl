{"id": "IN-2025-002", "record_type": "incident", "date": "2025-02-01", "date_precision": "day", "country": "IN", "region": "Noida, Uttar Pradesh", "scam_type": "digital_arrest", "claimed_identity": ["telecom regulator (TRAI) referral", "Mumbai cyber crime branch", "IPS officer"], "channel": ["phone", "video_call"], "ai_voice": "not_reported", "victim_profile": "family of three (parents and daughter)", "loss": 11000000, "currency": "INR", "recovered": null, "outcome": "case registered", "tactics": ["sim_block_threat", "authority", "money_laundering_accusation", "threat_of_arrest", "isolation", "money_transfer"], "summary": "A caller warned the family's SIM would be blocked and referred them to TRAI; a fake IPS officer then said 24 cases were registered against the father for money laundering. The wife and daughter were also told they were under digital arrest and could not leave the house. About Rs 1.1 crore was transferred over five days.", "sources": [{"url": "https://www.indiatvnews.com/technology/news/noida-family-fooled-in-digital-arrest-scam-lost-rs-1-crore-fraudsters-posed-as-cops-2025-02-11-975720", "publisher": "India TV", "source_type": "news", "published": "2025-02-11", "accessed": "2026-10-24", "fetched": true, "supports": ["date", "region", "claimed_identity", "channel", "loss", "tactics"], "note": ""}, {"url": "https://www.digit.in/news/general/lost-over-rs-1-cr-noida-family-becomes-latest-victim-of-digital-scam-heres-what-happened.html", "publisher": "Digit", "source_type": "news", "published": "2025-02", "accessed": "2026-10-24", "fetched": true, "supports": ["date", "region", "claimed_identity", "loss", "tactics"], "note": ""}], "note": "", "verification_level": "B", "loss_usd_approx": 127907}
