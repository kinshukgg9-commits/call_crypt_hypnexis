+++ b/backend/storage/__init__.py
@@ -0,0 +1,76 @@
+"""Optional MySQL storage for analysed calls: tables in schema.py, lifecycle in repository.py,
+non-blocking writes in store.py, REST endpoints in api.py. Off unless DATABASE_URL is set."""
+from __future__ import annotations
+
+import time
+from typing import Any, Mapping
+
+from backend import __version__
+from backend.schemas import AnalysisResult, Verdict
+from backend.storage.config import StorageSettings
+from backend.storage.records import CallRecord, hash_client_id
+from backend.storage.store import Storage, StorageUnavailable
+
+__all__ = ["CallRecord", "Storage", "StorageSettings", "StorageUnavailable", "record_stream", "record_upload"]
+
+_END_REASONS = {"stop": "stopped", "disconnect": "disconnected", "idle": "idle_timeout", "error": "error"}
+
+
+def _consent(raw: str | None) -> bool | None:
+    if raw is None:
+        return None
+    return raw.lower() in ("1", "true", "yes", "on")
+
+
+def record_stream(storage: Storage, session: Any, params: Mapping[str, str]) -> bool:
+    """Queues a finished live session. `params` are the WebSocket's query parameters
+    (?source=mic|tab&consent=1&client=<browser id>): browsers can't set WebSocket headers."""
+    if not storage.settings.enabled or not session.results:
+        return False                                      # nothing analysed: nothing worth keeping
+    record = CallRecord.from_results(
+        session.results,
+        store_transcript=storage.settings.store_transcripts,
+        client_session_id=session.session_id,
+        source=params.get("source") or "live",
+        end_reason=_END_REASONS.get(session.end_reason, "error"),
+        verdict=session.verdict.snapshot(final=True),
+        started_at=session.started_at,
+        ended_at=time.time(),
+        client_hash=hash_client_id(params.get("client")),
+        consent_given=_consent(params.get("consent")),
+        input_sample_rate=session.input_rate,
+        audio_seconds=session.results[-1].timestamp,
+        windows_analysed=session.analysed,
+        windows_dropped=session.dropped,
+        app_version=__version__,
+    )
+    return storage.submit(record)
+
+
+def record_upload(
+    storage: Storage, *, session_id: str, results: list[AnalysisResult], verdict: Verdict, duration: float,
+    filename: str | None, content_type: str | None, size_bytes: int, started_at: float,
+    client_id: str | None, consent: str | None,
+) -> bool:
+    """Queues an analysed upload."""
+    if not storage.settings.enabled:
+        return False
+    record = CallRecord.from_results(
+        results,
+        store_transcript=storage.settings.store_transcripts,
+        client_session_id=session_id,
+        source="file",
+        end_reason="completed",
+        verdict=verdict,
+        started_at=started_at,
+        ended_at=time.time(),
+        client_hash=hash_client_id(client_id),
+        consent_given=_consent(consent),
+        file_name=filename,
+        file_type=content_type,
+        file_size_bytes=size_bytes,
+        audio_seconds=duration,
+        windows_analysed=len(results),
+        app_version=__version__,
+    )
+    return storage.submit(record)
diff --git a/backend/storage/api.py b/backend/storage/api.py
new file mode 100644
index 0000000..3cd9048
--- /dev/null
+++ b/backend/storage/api.py
@@ -0,0 +1,209 @@
+"""REST endpoints for stored calls. Mounted by backend/app.py only when DATABASE_URL is set.
+
+There are no accounts in VoiceGuard, so each browser sends a random id it keeps in localStorage
+as the X-VoiceGuard-Client header. The server stores only its SHA-256, and a browser only ever
+sees (and can delete or give feedback on) its own calls.
+
+  GET    /api/history                     this browser's calls, newest first
+  GET    /api/history/{session_uid}       one call with its verdict and feedback
+  DELETE /api/history/{session_uid}       move one of this browser's calls to the trash
+  POST   /api/history/{session_uid}/feedback   {"is_correct": bool, "actual_label": ..., "comment": ...}
+  GET    /api/storage/status              table sizes, archive cycle, writer queue
+  POST   /api/storage/maintenance         run the lifecycle job now          (X-Admin-Token)
+  POST   /api/storage/trash/{uid}/restore move a call back out of the trash  (X-Admin-Token)
+"""
+from __future__ import annotations
+
+import hmac
+import re
+from typing import Any, Literal
+
+from fastapi import APIRouter, Header, Path, Query
+from pydantic import BaseModel, Field
+
+from backend.storage import repository
+from backend.storage.records import hash_client_id
+from backend.storage.store import Storage, StorageUnavailable
+
+UID_PATTERN = r"^[0-9a-f]{32}$"
+_UID_RE = re.compile(UID_PATTERN)
+
+
+class FeedbackIn(BaseModel):
+    is_correct: bool = Field(description="Was VoiceGuard's result right?")
+    actual_label: Literal["safe", "ai_voice", "scam", "unsure"] | None = Field(
+        default=None, description="What the call really was, if the user knows."
+    )
+    comment: str | None = Field(default=None, max_length=500)
+
+
+class FeedbackOut(BaseModel):
+    session_uid: str
+    status: Literal["created", "updated"]
+
+
+class HistoryItem(BaseModel):
+    session_uid: str
+    tier: Literal["recent", "archive"]
+    source: str
+    file_name: str | None
+    audio_seconds: float
+    started_at: str | None
+    ended_at: str | None
+    created_at: str
+    end_reason: str
+    verdict: str | None
+    title: str | None
+    scam_score: float | None
+    ai_voice: bool | None
+    voice_score: float | None
+    reasons: list[str]
+    has_feedback: bool
+
+
+class HistoryPage(BaseModel):
+    items: list[HistoryItem]
+    limit: int
+    offset: int
+
+
+def _jsonable(value: Any) -> Any:
+    if isinstance(value, dict):
+        return {k: _jsonable(v) for k, v in value.items() if k != "client_hash"}
+    if isinstance(value, list):
+        return [_jsonable(v) for v in value]
+    if hasattr(value, "isoformat"):
+        return value.isoformat(timespec="milliseconds") + "Z"
+    return value
+
+
+def build_router(storage: Storage, api_error: type[Exception]) -> APIRouter:
+    """`api_error(status, code, detail)` is backend.app.ApiError, so errors keep the app's {detail, code} shape."""
+    router = APIRouter(tags=["storage"])
+    s = storage.settings
+
+    def client(raw: str | None) -> str:
+        hashed = hash_client_id(raw)
+        if hashed is None:
+            raise api_error(400, "missing_client_id",
+                            "Send X-VoiceGuard-Client: an 8-64 character id made of letters, digits, '-' or '_'.")
+        return hashed
+
+    def admin(token: str | None) -> None:
+        if not s.admin_token:
+            raise api_error(403, "admin_disabled", "Set STORAGE_ADMIN_TOKEN on the server to use this endpoint.")
+        if not token or not hmac.compare_digest(token, s.admin_token):
+            raise api_error(403, "forbidden", "Wrong or missing X-Admin-Token.")
+
+    db = storage.connection                  # raises StorageUnavailable on entry; endpoints turn it into a 503
+
+    # Plain `def` endpoints: FastAPI runs them in its thread pool, so a slow query never blocks
+    # the event loop that carries live audio.
+    @router.get("/api/history", response_model=HistoryPage)
+    def history(
+        limit: int = Query(20, ge=1, le=100),
+        offset: int = Query(0, ge=0, le=10_000),
+        x_voiceguard_client: str | None = Header(None),
+    ) -> HistoryPage:
+        """This browser's stored calls (recent and archive), newest first."""
+        hashed = client(x_voiceguard_client)
+        try:
+            with db() as conn:
+                rows = repository.list_history(conn, hashed, limit, offset)
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        return HistoryPage(items=[HistoryItem(**r) for r in rows], limit=limit, offset=offset)
+
+    @router.get("/api/history/{session_uid}")
+    def history_item(
+        session_uid: str = Path(pattern=UID_PATTERN),
+        x_voiceguard_client: str | None = Header(None),
+    ) -> dict:
+        """One of this browser's calls, with its verdict, per-window scores and feedback."""
+        hashed = client(x_voiceguard_client)
+        try:
+            with db() as conn:
+                call = repository.get_call(conn, session_uid)
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        if not call or call["tier"] == "trash" or call["client_hash"] != hashed:
+            raise api_error(404, "not_found", "No such call in this browser's history.")
+        call["feedback"] = [f for f in call["feedback"] if f["client_hash"] == hashed]
+        return _jsonable(call)
+
+    @router.delete("/api/history/{session_uid}")
+    def delete_item(
+        session_uid: str = Path(pattern=UID_PATTERN),
+        x_voiceguard_client: str | None = Header(None),
+    ) -> dict:
+        """Moves one of this browser's calls to the trash (purged after DB_TRASH_RETENTION_DAYS)."""
+        hashed = client(x_voiceguard_client)
+        try:
+            with db() as conn:
+                outcome = repository.trash_call(conn, session_uid, hashed, storage.clock())
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        if outcome != "ok":
+            raise api_error(404, "not_found", "No such call in this browser's history.")
+        return {"session_uid": session_uid, "status": "trashed"}
+
+    @router.post("/api/history/{session_uid}/feedback", response_model=FeedbackOut)
+    def feedback(
+        body: FeedbackIn,
+        session_uid: str = Path(pattern=UID_PATTERN),
+        x_voiceguard_client: str | None = Header(None),
+    ) -> FeedbackOut:
+        """Saves (or replaces) this browser's feedback on a call's result."""
+        hashed = client(x_voiceguard_client)
+        comment = (body.comment or "").strip() or None
+        try:
+            with db() as conn:
+                status = repository.save_feedback(
+                    conn, session_uid, hashed, body.is_correct, body.actual_label, comment, storage.clock()
+                )
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        if status is None:
+            raise api_error(404, "not_found", "No such call (it may have expired).")
+        return FeedbackOut(session_uid=session_uid, status=status)
+
+    @router.get("/api/storage/status")
+    def storage_status() -> dict:
+        """Writer state, plus table sizes and the archive cycle when the database is reachable."""
+        out: dict[str, Any] = {"writer": storage.status()}
+        if storage.state == "ready":
+            try:
+                with storage.connection() as conn:
+                    out.update(repository.stats(conn, s))
+            except StorageUnavailable as exc:
+                out["writer"]["error"] = str(exc)
+        return out
+
+    @router.post("/api/storage/maintenance")
+    def maintenance(x_admin_token: str | None = Header(None)) -> dict:
+        """Runs the lifecycle job now instead of waiting for the next scheduled run."""
+        admin(x_admin_token)
+        try:
+            result = storage.maintain_now()
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        if result is None:
+            raise api_error(409, "maintenance_running", "Maintenance is already running; try again shortly.")
+        return result
+
+    @router.post("/api/storage/trash/{session_uid}/restore")
+    def restore(session_uid: str = Path(pattern=UID_PATTERN), x_admin_token: str | None = Header(None)) -> dict:
+        """Moves a call from the trash back to the recent table."""
+        admin(x_admin_token)
+        try:
+            with db() as conn:
+                outcome = repository.restore_call(conn, session_uid, s, storage.clock())
+        except StorageUnavailable as exc:
+            raise api_error(503, "storage_unavailable", str(exc)) from None
+        if outcome == "not_found":
+            raise api_error(404, "not_found", "No such call in the trash.")
+        if outcome == "expired":
+            raise api_error(409, "expired", f"Calls older than {s.trash_after_days:g} days can't be restored.")
+        return {"session_uid": session_uid, "status": "restored"}
+
+    return router
diff --git a/backend/storage/config.py b/backend/storage/config.py
new file mode 100644
index 0000000..30b8be8
--- /dev/null
+++ b/backend/storage/config.py
@@ -0,0 +1,83 @@
+"""Storage settings, read once from environment variables (same style as backend/config.py).
+
+Storage is off unless DATABASE_URL is set, so the app and its tests keep working with no
+database at all. Example:
+
+    DATABASE_URL=mysql://voiceguard:secret@db.example.com:3306/voiceguard?ssl=true
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from urllib.parse import parse_qs, unquote, urlparse
+
+from backend.config import _bool, _float, _int, _str
+
+
+@dataclass(frozen=True)
+class StorageSettings:
+    database_url: str | None = None
+
+    # Record lifecycle (see backend/storage/lifecycle.py)
+    recent_rows: int = 300              # vg_sessions_recent holds at most this many calls
+    recent_days: float = 5.0            # ... and none older than this
+    max_live_rows: int = 600            # recent + archive together; the oldest are evicted beyond it
+    archive_reset_days: float = 5.0     # vg_sessions_archive is emptied into the trash this often
+    trash_after_days: float = 10.0      # any call older than this goes to the trash
+    trash_retention_days: float = 10.0  # the trash is purged (for good) after this
+    max_trash_rows: int = 600
+    maintenance_seconds: float = 300.0  # how often the lifecycle job runs
+
+    # Writing
+    queue_size: int = 500               # records waiting for the database, in memory
+    batch_size: int = 50                # records written per transaction
+    connect_timeout: float = 5.0
+    store_transcripts: bool = False     # transcripts can hold OTPs and names: off by default
+    admin_token: str | None = None      # guards the maintenance / restore endpoints
+
+    @property
+    def enabled(self) -> bool:
+        return bool(self.database_url)
+
+    def connect_kwargs(self) -> dict:
+        """PyMySQL keyword arguments parsed from DATABASE_URL."""
+        url = urlparse(self.database_url or "")
+        if url.scheme not in ("mysql", "mysql+pymysql"):
+            raise ValueError("DATABASE_URL must start with mysql://")
+        query = {k: v[-1] for k, v in parse_qs(url.query).items()}
+        kwargs = {
+            "host": url.hostname or "localhost",
+            "port": url.port or 3306,
+            "user": unquote(url.username or ""),
+            "password": unquote(url.password or ""),
+            "database": url.path.lstrip("/"),
+            "charset": "utf8mb4",
+            "connect_timeout": self.connect_timeout,
+            "read_timeout": 15,
+            "write_timeout": 15,
+            "autocommit": False,
+        }
+        if not kwargs["database"]:
+            raise ValueError("DATABASE_URL must name a database, e.g. mysql://user:pass@host/voiceguard")
+        if query.get("ssl", "").lower() in ("1", "true", "required"):
+            # Managed MySQL hosts require TLS; the system CA bundle verifies them.
+            kwargs.update(ssl_verify_cert=True, ssl_verify_identity=True, ssl_ca=query.get("ssl_ca"))
+        return kwargs
+
+    @classmethod
+    def from_env(cls) -> StorageSettings:
+        return cls(
+            database_url=_str("DATABASE_URL", None),
+            recent_rows=_int("DB_RECENT_ROWS", 300, 1, 1_000_000),
+            recent_days=_float("DB_RECENT_DAYS", 5.0, 0.001, 3650.0),
+            max_live_rows=_int("DB_MAX_ROWS", 600, 1, 10_000_000),
+            archive_reset_days=_float("DB_ARCHIVE_RESET_DAYS", 5.0, 0.001, 3650.0),
+            trash_after_days=_float("DB_TRASH_AFTER_DAYS", 10.0, 0.001, 3650.0),
+            trash_retention_days=_float("DB_TRASH_RETENTION_DAYS", 10.0, 0.0, 3650.0),
+            max_trash_rows=_int("DB_MAX_TRASH_ROWS", 600, 0, 10_000_000),
+            maintenance_seconds=_float("DB_MAINTENANCE_SECONDS", 300.0, 5.0, 86400.0),
+            queue_size=_int("DB_QUEUE_SIZE", 500, 1, 100_000),
+            batch_size=_int("DB_BATCH_SIZE", 50, 1, 10_000),
+            connect_timeout=_float("DB_CONNECT_TIMEOUT", 5.0, 0.5, 120.0),
+            store_transcripts=_bool("DB_STORE_TRANSCRIPTS", False),
+            admin_token=_str("STORAGE_ADMIN_TOKEN", None),
+        )
diff --git a/backend/storage/records.py b/backend/storage/records.py
new file mode 100644
index 0000000..d9f78dc
--- /dev/null
+++ b/backend/storage/records.py
@@ -0,0 +1,122 @@
+"""What gets stored for one analysed call, built from what the pipeline already has.
+
+Stored: how the call came in (source, consent box, sample rate, file name / type / size),
+how long it was, the call-level verdict and a per-window score summary.
+Not stored: audio (never), and transcripts unless DB_STORE_TRANSCRIPTS=true.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import uuid
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any, Iterable
+
+from backend.schemas import AnalysisResult, Verdict
+
+SOURCES = ("mic", "tab", "live", "file")
+END_REASONS = ("stopped", "completed", "disconnected", "idle_timeout", "error")
+_RISK_ORDER = {"low": 0, "medium": 1, "high": 2}
+CLIENT_ID_RE = re.compile(r"^[A-Za-z0-9_-]{8,64}$")
+# Long digit runs in a transcript are OTPs, PINs, card or account numbers: never keep them.
+_DIGITS_RE = re.compile(r"\d[\d\s-]{2,}\d")
+
+
+def utc(ts: float) -> datetime:
+    """Epoch seconds -> naive UTC datetime, which is what DATETIME(3) columns hold."""
+    return datetime.fromtimestamp(ts, timezone.utc).replace(tzinfo=None)
+
+
+def hash_client_id(raw: str | None) -> str | None:
+    """The browser's anonymous id is stored only as a hash."""
+    if not raw or not CLIENT_ID_RE.match(raw):
+        return None
+    return hashlib.sha256(raw.encode()).hexdigest()
+
+
+def mask_digits(text: str) -> str:
+    return _DIGITS_RE.sub("[number]", text)
+
+
+def window_summary(r: AnalysisResult) -> dict[str, Any]:
+    return {
+        "i": r.window_index,
+        "t": round(r.timestamp, 2),
+        "risk": r.risk,
+        "scam": round(r.scam_score, 3),
+        "voice": None if r.voice_score is None else round(r.voice_score, 3),
+        "flag": r.voice_flag,
+        "reasons": r.reasons,
+    }
+
+
+@dataclass
+class CallRecord:
+    client_session_id: str
+    source: str
+    end_reason: str
+    verdict: Verdict
+    ended_at: float                               # epoch seconds
+    started_at: float | None = None
+    client_hash: str | None = None
+    consent_given: bool | None = None
+    input_sample_rate: int | None = None
+    file_name: str | None = None
+    file_type: str | None = None
+    file_size_bytes: int | None = None
+    audio_seconds: float = 0.0
+    windows_analysed: int = 0
+    windows_dropped: int = 0
+    app_version: str | None = None
+    windows: list[dict[str, Any]] = field(default_factory=list)
+    languages: list[str] = field(default_factory=list)
+    transcript: str | None = None
+    session_uid: str = field(default_factory=lambda: uuid.uuid4().hex)
+
+    def __post_init__(self) -> None:
+        if self.source not in SOURCES:
+            self.source = "live"
+        if self.end_reason not in END_REASONS:
+            self.end_reason = "error"
+        if self.file_name:
+            self.file_name = self.file_name[:255]
+        if self.file_type:
+            self.file_type = self.file_type[:100]
+
+    @classmethod
+    def from_results(
+        cls, results: Iterable[AnalysisResult], *, store_transcript: bool = False, **fields: Any
+    ) -> CallRecord:
+        results = list(results)
+        languages: list[str] = []
+        for r in results:
+            if r.language and r.language not in languages:
+                languages.append(r.language)
+        transcript = None
+        if store_transcript:
+            lines = [f"[{r.timestamp:.0f}s] {mask_digits(r.transcript)}" for r in results if r.transcript]
+            transcript = "\n".join(lines) or None
+        return cls(windows=[window_summary(r) for r in results], languages=languages, transcript=transcript, **fields)
+
+    # -- rows ---------------------------------------------------------------------
+    def session_row(self, now: float) -> tuple:
+        return (
+            self.session_uid, self.client_session_id[:64], self.client_hash, self.source,
+            None if self.consent_given is None else int(self.consent_given), self.input_sample_rate,
+            self.file_name, self.file_type, self.file_size_bytes, round(self.audio_seconds, 3),
+            self.windows_analysed, self.windows_dropped, self.end_reason, self.app_version,
+            utc(self.started_at) if self.started_at else None, utc(self.ended_at), utc(now),
+        )
+
+    def verdict_row(self, now: float) -> tuple:
+        v = self.verdict
+        max_risk = max((w["risk"] for w in self.windows), key=_RISK_ORDER.get, default="low")
+        return (
+            self.session_uid, v.verdict, v.title[:120], v.message[:500], v.scam_score, max_risk,
+            json.dumps(v.reasons), int(v.ai_voice), v.voice_score, v.voice_flagged, v.voice_windows,
+            v.windows, v.speech_seconds, ",".join(self.languages)[:64] or None,
+            json.dumps(self.windows, separators=(",", ":")) if self.windows else None,
+            self.transcript, utc(now),
+        )
diff --git a/backend/storage/repository.py b/backend/storage/repository.py
new file mode 100644
index 0000000..fd81e2b
--- /dev/null
+++ b/backend/storage/repository.py
@@ -0,0 +1,322 @@
+"""SQL for VoiceGuard storage. Every function takes an open PyMySQL connection and commits its own work.
+
+Record lifecycle (run_maintenance), in this order:
+  1. archive reset   every DB_ARCHIVE_RESET_DAYS the whole archive moves to the trash
+  2. expiry          any call older than DB_TRASH_AFTER_DAYS moves to the trash
+  3. ageing          calls older than DB_RECENT_DAYS move from recent to archive
+  4. recent cap      beyond DB_RECENT_ROWS, the oldest recent calls move to archive
+  5. capacity        beyond DB_MAX_ROWS (recent + archive), the oldest calls move to the trash
+  6. purge           trash older than DB_TRASH_RETENTION_DAYS, or beyond DB_MAX_TRASH_ROWS, is deleted
+                     for good, together with its verdict and feedback
+Moves are INSERT ... SELECT + DELETE by primary key in one transaction, so a call is never in two
+tables at once and never lost half-way.
+"""
+from __future__ import annotations
+
+import json
+from datetime import timedelta
+from typing import Any, Sequence
+
+from backend.storage.config import StorageSettings
+from backend.storage.records import CallRecord, utc
+from backend.storage.schema import SESSION_COLUMNS
+
+_COLS = ", ".join(SESSION_COLUMNS)
+_CHUNK = 500
+TIERS = {"recent": "vg_sessions_recent", "archive": "vg_sessions_archive", "trash": "vg_sessions_trash"}
+
+_INSERT_SESSION = f"INSERT INTO vg_sessions_recent ({_COLS}) VALUES ({', '.join(['%s'] * len(SESSION_COLUMNS))})"
+_INSERT_VERDICT = (
+    "INSERT INTO vg_verdicts (session_uid, verdict, title, message, scam_score, max_risk, reasons, ai_voice, "
+    "voice_score, voice_flagged, voice_windows, windows, speech_seconds, languages, window_summary, transcript, "
+    "created_at) VALUES (" + ", ".join(["%s"] * 17) + ")"
+)
+
+
+# -- writes -----------------------------------------------------------------------------
+def insert_records(conn, records: Sequence[CallRecord], now: float) -> int:
+    """Stores calls in vg_sessions_recent + vg_verdicts. PyMySQL turns executemany into one multi-row INSERT."""
+    if not records:
+        return 0
+    with conn.cursor() as cur:
+        cur.executemany(_INSERT_SESSION, [r.session_row(now) for r in records])
+        cur.executemany(_INSERT_VERDICT, [r.verdict_row(now) for r in records])
+    conn.commit()
+    return len(records)
+
+
+def _in(uids: Sequence[str]) -> str:
+    return ", ".join(["%s"] * len(uids))
+
+
+def _move(cur, src: str, dst: str, uids: Sequence[str], extra_cols: str = "", extra_vals: tuple = ()) -> int:
+    """Moves rows by primary key from one vg_sessions_* table to another."""
+    moved = 0
+    for i in range(0, len(uids), _CHUNK):
+        chunk = list(uids[i:i + _CHUNK])
+        placeholders = ", ".join(["%s"] * len(extra_vals))
+        cur.execute(
+            f"INSERT INTO {TIERS[dst]} ({_COLS}{extra_cols}) "
+            f"SELECT {_COLS}{', ' + placeholders if extra_vals else ''} FROM {TIERS[src]} "
+            f"WHERE session_uid IN ({_in(chunk)})",
+            (*extra_vals, *chunk),
+        )
+        cur.execute(f"DELETE FROM {TIERS[src]} WHERE session_uid IN ({_in(chunk)})", chunk)
+        moved += cur.rowcount
+    return moved
+
+
+def _to_trash(cur, src: str, uids: Sequence[str], reason: str, now) -> int:
+    return _move(cur, src, "trash", uids, ", trashed_at, trash_reason, trashed_from", (now, reason, src))
+
+
+def _to_archive(cur, uids: Sequence[str], now, cycle_id: int) -> int:
+    return _move(cur, "recent", "archive", uids, ", archived_at, archive_cycle", (now, cycle_id))
+
+
+def _uids(cur, sql: str, args: tuple = ()) -> list[str]:
+    cur.execute(sql, args)
+    return [row[0] for row in cur.fetchall()]
+
+
+def _count(cur, table: str) -> int:
+    cur.execute(f"SELECT COUNT(*) FROM {table}")
+    return int(cur.fetchone()[0])
+
+
+def _current_cycle(cur, now) -> tuple[int, Any]:
+    cur.execute("SELECT cycle_id, started_at FROM vg_archive_cycles WHERE reset_at IS NULL "
+                "ORDER BY cycle_id DESC LIMIT 1 FOR UPDATE")
+    row = cur.fetchone()
+    if row:
+        return int(row[0]), row[1]
+    cur.execute("INSERT INTO vg_archive_cycles (started_at) VALUES (%s)", (now,))
+    return int(cur.lastrowid), now
+
+
+def _purge(cur, uids: Sequence[str]) -> int:
+    purged = 0
+    for i in range(0, len(uids), _CHUNK):
+        chunk = list(uids[i:i + _CHUNK])
+        cur.execute(f"DELETE FROM vg_feedback WHERE session_uid IN ({_in(chunk)})", chunk)
+        cur.execute(f"DELETE FROM vg_verdicts WHERE session_uid IN ({_in(chunk)})", chunk)
+        cur.execute(f"DELETE FROM vg_sessions_trash WHERE session_uid IN ({_in(chunk)})", chunk)
+        purged += cur.rowcount
+    return purged
+
+
+def run_maintenance(conn, s: StorageSettings, now_ts: float) -> dict[str, int] | None:
+    """Applies the lifecycle above. Returns what moved, or None if another process holds the lock."""
+    now = utc(now_ts)
+    out = dict(archive_reset=0, expired=0, aged=0, recent_overflow=0, capacity=0, purged=0)
+    with conn.cursor() as cur:
+        cur.execute("SELECT GET_LOCK('vg_maintenance', 0)")
+        if cur.fetchone()[0] != 1:
+            conn.rollback()
+            return None
+        try:
+            # 1. archive reset
+            cycle_id, started = _current_cycle(cur, now)
+            if now - started >= timedelta(days=s.archive_reset_days):
+                uids = _uids(cur, "SELECT session_uid FROM vg_sessions_archive FOR UPDATE")
+                out["archive_reset"] = _to_trash(cur, "archive", uids, "archive_reset", now)
+                cur.execute("UPDATE vg_archive_cycles SET reset_at = %s, rows_trashed = %s WHERE cycle_id = %s",
+                            (now, out["archive_reset"], cycle_id))
+                cur.execute("INSERT INTO vg_archive_cycles (started_at) VALUES (%s)", (now,))
+                cycle_id = int(cur.lastrowid)
+
+            # 2. expiry
+            cutoff = now - timedelta(days=s.trash_after_days)
+            for tier in ("recent", "archive"):
+                uids = _uids(cur, f"SELECT session_uid FROM {TIERS[tier]} WHERE created_at < %s FOR UPDATE", (cutoff,))
+                out["expired"] += _to_trash(cur, tier, uids, "expired", now)
+
+            # 3. ageing, 4. recent cap
+            cutoff = now - timedelta(days=s.recent_days)
+            uids = _uids(cur, "SELECT session_uid FROM vg_sessions_recent WHERE created_at < %s FOR UPDATE", (cutoff,))
+            out["aged"] = _to_archive(cur, uids, now, cycle_id)
+            extra = _count(cur, "vg_sessions_recent") - s.recent_rows
+            if extra > 0:
+                uids = _uids(cur, "SELECT session_uid FROM vg_sessions_recent ORDER BY created_at, session_uid "
+                                  "LIMIT %s FOR UPDATE", (extra,))
+                out["recent_overflow"] = _to_archive(cur, uids, now, cycle_id)
+
+            # 5. capacity: the oldest calls go first, from the archive before the recent table
+            extra = _count(cur, "vg_sessions_recent") + _count(cur, "vg_sessions_archive") - s.max_live_rows
+            for tier in ("archive", "recent"):
+                if extra <= 0:
+                    break
+                uids = _uids(cur, f"SELECT session_uid FROM {TIERS[tier]} ORDER BY created_at, session_uid "
+                                  "LIMIT %s FOR UPDATE", (extra,))
+                moved = _to_trash(cur, tier, uids, "capacity", now)
+                out["capacity"] += moved
+                extra -= moved
+
+            # 6. purge
+            cutoff = now - timedelta(days=s.trash_retention_days)
+            uids = _uids(cur, "SELECT session_uid FROM vg_sessions_trash WHERE trashed_at < %s", (cutoff,))
+            out["purged"] = _purge(cur, uids)
+            extra = _count(cur, "vg_sessions_trash") - s.max_trash_rows
+            if extra > 0:
+                uids = _uids(cur, "SELECT session_uid FROM vg_sessions_trash ORDER BY trashed_at, created_at "
+                                  "LIMIT %s", (extra,))
+                out["purged"] += _purge(cur, uids)
+            conn.commit()
+        except Exception:
+            conn.rollback()
+            raise
+        finally:
+            cur.execute("SELECT RELEASE_LOCK('vg_maintenance')")
+    return out
+
+
+# -- user actions ---------------------------------------------------------------------------
+def find_tier(cur, session_uid: str, lock: bool = False) -> tuple[str, str | None] | None:
+    """(tier, client_hash) of a call, or None."""
+    for tier, table in TIERS.items():
+        cur.execute(f"SELECT client_hash FROM {table} WHERE session_uid = %s{' FOR UPDATE' if lock else ''}",
+                    (session_uid,))
+        row = cur.fetchone()
+        if row:
+            return tier, row[0]
+    return None
+
+
+def trash_call(conn, session_uid: str, client_hash: str | None, now_ts: float) -> str:
+    """Moves one call to the trash for its owner. Returns 'ok', 'not_found' or 'forbidden'."""
+    with conn.cursor() as cur:
+        found = find_tier(cur, session_uid, lock=True)
+        if not found or found[0] == "trash":
+            conn.rollback()
+            return "not_found"
+        if client_hash is None or found[1] != client_hash:
+            conn.rollback()
+            return "forbidden"
+        _to_trash(cur, found[0], [session_uid], "user_deleted", utc(now_ts))
+    conn.commit()
+    return "ok"
+
+
+def restore_call(conn, session_uid: str, s: StorageSettings, now_ts: float) -> str:
+    """Moves a call from the trash back to recent. Returns 'ok', 'not_found' or 'expired'."""
+    with conn.cursor() as cur:
+        cur.execute("SELECT created_at FROM vg_sessions_trash WHERE session_uid = %s FOR UPDATE", (session_uid,))
+        row = cur.fetchone()
+        if not row:
+            conn.rollback()
+            return "not_found"
+        if utc(now_ts) - row[0] >= timedelta(days=s.trash_after_days):
+            conn.rollback()
+            return "expired"                       # it would go straight back to the trash
+        _move(cur, "trash", "recent", [session_uid])
+    conn.commit()
+    return "ok"
+
+
+def save_feedback(conn, session_uid: str, client_hash: str, is_correct: bool, actual_label: str | None,
+                  comment: str | None, now_ts: float) -> str | None:
+    """Creates or replaces this browser's feedback on a call. Returns 'created', 'updated' or None (no such call)."""
+    now = utc(now_ts)
+    with conn.cursor() as cur:
+        found = find_tier(cur, session_uid)
+        if not found or found[0] == "trash":
+            conn.rollback()
+            return None
+        cur.execute("SELECT feedback_id FROM vg_feedback WHERE session_uid = %s AND client_hash = %s FOR UPDATE",
+                    (session_uid, client_hash))
+        row = cur.fetchone()
+        if row:
+            cur.execute("UPDATE vg_feedback SET is_correct = %s, actual_label = %s, comment = %s, updated_at = %s "
+                        "WHERE feedback_id = %s", (int(is_correct), actual_label, comment, now, row[0]))
+        else:
+            cur.execute("INSERT INTO vg_feedback (session_uid, client_hash, is_correct, actual_label, comment, "
+                        "created_at, updated_at) VALUES (%s, %s, %s, %s, %s, %s, %s)",
+                        (session_uid, client_hash, int(is_correct), actual_label, comment, now, now))
+    conn.commit()
+    return "updated" if row else "created"
+
+
+# -- reads ----------------------------------------------------------------------------------
+_HISTORY_FIELDS = ("session_uid, source, file_name, audio_seconds, started_at, ended_at, created_at, "
+                   "end_reason")
+
+
+def _iso(value) -> str | None:
+    return None if value is None else value.isoformat(timespec="milliseconds") + "Z"
+
+
+def list_history(conn, client_hash: str, limit: int, offset: int = 0) -> list[dict[str, Any]]:
+    """This browser's calls in recent + archive, newest first, with their verdicts."""
+    with conn.cursor() as cur:
+        cur.execute(
+            f"""SELECT h.*, v.verdict, v.title, v.scam_score, v.ai_voice, v.voice_score, v.reasons,
+                       EXISTS (SELECT 1 FROM vg_feedback f WHERE f.session_uid = h.session_uid
+                               AND f.client_hash = %s) AS has_feedback
+                FROM (SELECT {_HISTORY_FIELDS}, 'recent' AS tier FROM vg_sessions_recent WHERE client_hash = %s
+                      UNION ALL
+                      SELECT {_HISTORY_FIELDS}, 'archive' AS tier FROM vg_sessions_archive WHERE client_hash = %s) h
+                LEFT JOIN vg_verdicts v ON v.session_uid = h.session_uid
+                ORDER BY h.created_at DESC, h.ended_at DESC LIMIT %s OFFSET %s""",
+            (client_hash, client_hash, client_hash, limit, offset),
+        )
+        names = [d[0] for d in cur.description]
+        rows = [dict(zip(names, row)) for row in cur.fetchall()]
+    conn.commit()
+    for r in rows:
+        for key in ("started_at", "ended_at", "created_at"):
+            r[key] = _iso(r[key])
+        r["reasons"] = json.loads(r["reasons"]) if r["reasons"] else []
+        r["ai_voice"] = None if r["ai_voice"] is None else bool(r["ai_voice"])
+        r["has_feedback"] = bool(r["has_feedback"])
+    return rows
+
+
+def get_call(conn, session_uid: str) -> dict[str, Any] | None:
+    """One call from any tier, with its verdict and feedback."""
+    with conn.cursor() as cur:
+        found = find_tier(cur, session_uid)
+        if not found:
+            conn.commit()
+            return None
+        tier = found[0]
+        cur.execute(f"SELECT * FROM {TIERS[tier]} WHERE session_uid = %s", (session_uid,))
+        names = [d[0] for d in cur.description]
+        call = dict(zip(names, cur.fetchone()))
+        cur.execute("SELECT * FROM vg_verdicts WHERE session_uid = %s", (session_uid,))
+        row = cur.fetchone()
+        verdict = dict(zip([d[0] for d in cur.description], row)) if row else None
+        cur.execute("SELECT client_hash, is_correct, actual_label, comment, created_at, updated_at "
+                    "FROM vg_feedback WHERE session_uid = %s ORDER BY feedback_id", (session_uid,))
+        feedback = [dict(zip([d[0] for d in cur.description], r)) for r in cur.fetchall()]
+    conn.commit()
+    call["tier"] = tier
+    call["verdict"] = verdict
+    call["feedback"] = feedback
+    return call
+
+
+def stats(conn, s: StorageSettings) -> dict[str, Any]:
+    with conn.cursor() as cur:
+        counts = {tier: _count(cur, table) for tier, table in TIERS.items()}
+        cur.execute("SELECT COUNT(*) FROM vg_feedback")
+        feedback = int(cur.fetchone()[0])
+        cur.execute("SELECT cycle_id, started_at FROM vg_archive_cycles WHERE reset_at IS NULL "
+                    "ORDER BY cycle_id DESC LIMIT 1")
+        cycle = cur.fetchone()
+        cur.execute("SELECT MIN(created_at) FROM vg_sessions_recent")
+        oldest_recent = cur.fetchone()[0]
+    conn.commit()
+    return {
+        "counts": {**counts, "feedback": feedback, "live": counts["recent"] + counts["archive"]},
+        "limits": {
+            "recent_rows": s.recent_rows, "recent_days": s.recent_days, "max_live_rows": s.max_live_rows,
+            "archive_reset_days": s.archive_reset_days, "trash_after_days": s.trash_after_days,
+            "trash_retention_days": s.trash_retention_days, "max_trash_rows": s.max_trash_rows,
+        },
+        "archive_cycle": None if not cycle else {
+            "cycle_id": int(cycle[0]),
+            "started_at": _iso(cycle[1]),
+            "next_reset_at": _iso(cycle[1] + timedelta(days=s.archive_reset_days)),
+        },
+        "oldest_recent_at": _iso(oldest_recent),
+    }
diff --git a/backend/storage/schema.py b/backend/storage/schema.py
new file mode 100644
index 0000000..307998f
--- /dev/null
+++ b/backend/storage/schema.py
@@ -0,0 +1,144 @@
+"""MySQL schema for VoiceGuard, applied as numbered migrations.
+
+Tables (all prefixed vg_):
+  vg_sessions_recent     the newest calls: at most DB_RECENT_ROWS (300), none older than DB_RECENT_DAYS (5)
+  vg_sessions_archive    calls pushed out of recent; emptied into the trash every DB_ARCHIVE_RESET_DAYS (5)
+  vg_sessions_trash      calls removed by age, capacity, archive reset or the user; purged after a while
+  vg_verdicts            the call-level result of each call (one row per session_uid)
+  vg_feedback            "was this result right?" answers from the user
+  vg_archive_cycles      one row per archive cycle, so the 5-day reset survives restarts
+  vg_schema_migrations   which of the migrations below have run
+
+A call keeps the same session_uid in whichever vg_sessions_* table it is in, so its verdict and
+feedback never move: only the session row does. No audio is stored, ever.
+
+The SQL sticks to MySQL 8 syntax that MariaDB 10.6+ also accepts.
+"""
+from __future__ import annotations
+
+import logging
+
+log = logging.getLogger("voiceguard.storage")
+
+# Columns every vg_sessions_* table shares, in the order INSERT ... SELECT copies them.
+SESSION_COLUMNS = (
+    "session_uid", "client_session_id", "client_hash", "source", "consent_given", "input_sample_rate",
+    "file_name", "file_type", "file_size_bytes", "audio_seconds", "windows_analysed", "windows_dropped",
+    "end_reason", "app_version", "started_at", "ended_at", "created_at",
+)
+
+_SESSION_DDL = """
+    session_uid        CHAR(32)      NOT NULL,
+    client_session_id  VARCHAR(64)   NOT NULL,
+    client_hash        CHAR(64)      NULL     COMMENT 'sha256 of the browser''s anonymous id',
+    source             ENUM('mic','tab','live','file') NOT NULL,
+    consent_given      TINYINT(1)    NULL     COMMENT 'consent box as reported by the client',
+    input_sample_rate  INT UNSIGNED  NULL,
+    file_name          VARCHAR(255)  NULL,
+    file_type          VARCHAR(100)  NULL,
+    file_size_bytes    INT UNSIGNED  NULL,
+    audio_seconds      DOUBLE        NOT NULL DEFAULT 0,
+    windows_analysed   INT UNSIGNED  NOT NULL DEFAULT 0,
+    windows_dropped    INT UNSIGNED  NOT NULL DEFAULT 0,
+    end_reason         ENUM('stopped','completed','disconnected','idle_timeout','error') NOT NULL,
+    app_version        VARCHAR(32)   NULL,
+    started_at         DATETIME(3)   NULL,
+    ended_at           DATETIME(3)   NOT NULL,
+    created_at         DATETIME(3)   NOT NULL,
+"""
+
+_TABLE_OPTIONS = "ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
+
+MIGRATIONS: list[tuple[int, str, list[str]]] = [
+    (1, "initial tables", [
+        f"""CREATE TABLE IF NOT EXISTS vg_sessions_recent ({_SESSION_DDL}
+            PRIMARY KEY (session_uid),
+            KEY idx_recent_created (created_at),
+            KEY idx_recent_client (client_hash, created_at)
+        ) {_TABLE_OPTIONS} COMMENT='Newest calls (hot tier)'""",
+        f"""CREATE TABLE IF NOT EXISTS vg_sessions_archive ({_SESSION_DDL}
+            archived_at    DATETIME(3)  NOT NULL,
+            archive_cycle  INT UNSIGNED NOT NULL,
+            PRIMARY KEY (session_uid),
+            KEY idx_archive_created (created_at),
+            KEY idx_archive_client (client_hash, created_at)
+        ) {_TABLE_OPTIONS} COMMENT='Older calls; emptied into the trash every archive cycle'""",
+        f"""CREATE TABLE IF NOT EXISTS vg_sessions_trash ({_SESSION_DDL}
+            trashed_at     DATETIME(3)  NOT NULL,
+            trash_reason   ENUM('expired','capacity','archive_reset','user_deleted') NOT NULL,
+            trashed_from   ENUM('recent','archive') NOT NULL,
+            PRIMARY KEY (session_uid),
+            KEY idx_trash_trashed (trashed_at)
+        ) {_TABLE_OPTIONS} COMMENT='Removed calls, restorable until purged'""",
+        f"""CREATE TABLE IF NOT EXISTS vg_verdicts (
+            session_uid     CHAR(32)      NOT NULL,
+            verdict         ENUM('safe','ai_voice','scam','inconclusive') NOT NULL,
+            title           VARCHAR(120)  NOT NULL,
+            message         VARCHAR(500)  NOT NULL,
+            scam_score      FLOAT         NOT NULL,
+            max_risk        ENUM('low','medium','high') NOT NULL,
+            reasons         JSON          NOT NULL COMMENT 'scam tactics matched, strongest first',
+            ai_voice        TINYINT(1)    NOT NULL,
+            voice_score     FLOAT         NULL,
+            voice_flagged   SMALLINT UNSIGNED NOT NULL DEFAULT 0,
+            voice_windows   SMALLINT UNSIGNED NOT NULL DEFAULT 0,
+            windows         INT UNSIGNED  NOT NULL DEFAULT 0,
+            speech_seconds  FLOAT         NOT NULL DEFAULT 0,
+            languages       VARCHAR(64)   NULL,
+            window_summary  JSON          NULL COMMENT 'per window: time, risk, scores; no transcript',
+            transcript      MEDIUMTEXT    NULL COMMENT 'only when DB_STORE_TRANSCRIPTS=true',
+            created_at      DATETIME(3)   NOT NULL,
+            PRIMARY KEY (session_uid),
+            KEY idx_verdicts_kind (verdict, created_at)
+        ) {_TABLE_OPTIONS} COMMENT='Call-level result, one per session'""",
+        f"""CREATE TABLE IF NOT EXISTS vg_feedback (
+            feedback_id    BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+            session_uid    CHAR(32)      NOT NULL,
+            client_hash    CHAR(64)      NOT NULL,
+            is_correct     TINYINT(1)    NOT NULL,
+            actual_label   ENUM('safe','ai_voice','scam','unsure') NULL,
+            comment        VARCHAR(500)  NULL,
+            created_at     DATETIME(3)   NOT NULL,
+            updated_at     DATETIME(3)   NOT NULL,
+            PRIMARY KEY (feedback_id),
+            UNIQUE KEY uq_feedback_session_client (session_uid, client_hash)
+        ) {_TABLE_OPTIONS} COMMENT='User feedback on a verdict'""",
+        f"""CREATE TABLE IF NOT EXISTS vg_archive_cycles (
+            cycle_id      INT UNSIGNED  NOT NULL AUTO_INCREMENT,
+            started_at    DATETIME(3)   NOT NULL,
+            reset_at      DATETIME(3)   NULL,
+            rows_trashed  INT UNSIGNED  NOT NULL DEFAULT 0,
+            PRIMARY KEY (cycle_id)
+        ) {_TABLE_OPTIONS} COMMENT='Archive reset history'""",
+    ]),
+]
+
+
+def migrate(conn) -> int:
+    """Applies any migrations not yet recorded. Safe to run from several processes at once."""
+    with conn.cursor() as cur:
+        cur.execute(
+            f"""CREATE TABLE IF NOT EXISTS vg_schema_migrations (
+                version     INT UNSIGNED NOT NULL,
+                name        VARCHAR(100) NOT NULL,
+                applied_at  DATETIME(3)  NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
+                PRIMARY KEY (version)
+            ) {_TABLE_OPTIONS}"""
+        )
+        cur.execute("SELECT GET_LOCK('vg_migrate', 30)")
+        try:
+            cur.execute("SELECT version FROM vg_schema_migrations")
+            done = {row[0] for row in cur.fetchall()}
+            applied = 0
+            for version, name, statements in MIGRATIONS:
+                if version in done:
+                    continue
+                for sql in statements:                 # DDL commits implicitly in MySQL
+                    cur.execute(sql)
+                cur.execute("INSERT INTO vg_schema_migrations (version, name) VALUES (%s, %s)", (version, name))
+                conn.commit()
+                log.info("database migration %d applied: %s", version, name)
+                applied += 1
+            return applied
+        finally:
+            cur.execute("SELECT RELEASE_LOCK('vg_migrate')")
diff --git a/backend/storage/store.py b/backend/storage/store.py
new file mode 100644
index 0000000..e17e7b8
--- /dev/null
+++ b/backend/storage/store.py
@@ -0,0 +1,237 @@
+"""The storage service: a background writer thread plus a tiny pool of reader connections.
+
+Why a writer thread: a WebSocket or upload must never wait for the database. `submit()` only
+puts the record on an in-memory queue (microseconds); the writer drains it in batches of up to
+DB_BATCH_SIZE calls per transaction over one long-lived connection, and runs the lifecycle job
+every DB_MAINTENANCE_SECONDS. If the database is down, records wait in the queue (the oldest is
+dropped beyond DB_QUEUE_SIZE) and the writer reconnects with backoff. Analysis never fails
+because of the database.
+
+Why long-lived connections: opening a TLS connection to a hosted MySQL costs 100-300 ms; reusing
+one costs a ping. Memory: PyMySQL is pure Python, a few MB in all.
+"""
+from __future__ import annotations
+
+import logging
+import queue
+import threading
+import time
+from contextlib import contextmanager
+from typing import Any, Callable, Iterator
+
+from backend.storage import repository
+from backend.storage.config import StorageSettings
+from backend.storage.records import CallRecord
+from backend.storage.schema import migrate
+
+log = logging.getLogger("voiceguard.storage")
+
+_POOL_SIZE = 2
+
+
+class StorageUnavailable(Exception):
+    pass
+
+
+def _alive(conn):
+    """The connection if a ping gets through, else None (closed). Idle hosted MySQL drops connections."""
+    if conn is None:
+        return None
+    try:
+        conn.ping(False)
+        return conn
+    except Exception:
+        try:
+            conn.close()
+        except Exception:
+            pass
+        return None
+
+
+class Storage:
+    def __init__(self, settings: StorageSettings, clock: Callable[[], float] = time.time,
+                 connect: Callable[..., Any] | None = None):
+        self.settings = settings
+        self.clock = clock
+        self._connect_fn = connect
+        self._queue: queue.Queue[CallRecord] = queue.Queue()
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._pool: list[Any] = []
+        self._pool_lock = threading.Lock()
+        self._pool_sem = threading.BoundedSemaphore(_POOL_SIZE)
+        self.state = "disabled" if not settings.enabled else "not_started"
+        self.error: str | None = None
+        self.written = 0
+        self.dropped = 0
+        self.last_maintenance: dict[str, Any] | None = None
+
+    # -- connections ----------------------------------------------------------------
+    def _connect(self):
+        if self._connect_fn:
+            return self._connect_fn()
+        import pymysql                                    # imported lazily: storage is optional
+
+        return pymysql.connect(**self.settings.connect_kwargs())
+
+    @contextmanager
+    def connection(self) -> Iterator[Any]:
+        """A pooled reader connection, checked with a ping (which reconnects if it dropped)."""
+        if self.state != "ready":
+            raise StorageUnavailable(self.error or "The database is not connected.")
+        with self._pool_sem:
+            with self._pool_lock:
+                conn = self._pool.pop() if self._pool else None
+            try:
+                conn = _alive(conn) or self._connect()
+            except Exception as exc:
+                raise StorageUnavailable(f"Database connection failed: {exc}") from None
+            ok = False
+            try:
+                yield conn
+                ok = True
+            finally:
+                if not ok:
+                    try:
+                        conn.rollback()
+                    except Exception:
+                        conn = None
+                if conn is not None:
+                    with self._pool_lock:
+                        self._pool.append(conn)
+
+    # -- lifecycle -----------------------------------------------------------------
+    def start(self) -> None:
+        """Starts the writer thread. Returns at once: connecting never delays server start-up."""
+        if not self.settings.enabled or self._thread:
+            return
+        self.state = "connecting"
+        self._thread = threading.Thread(target=self._run, name="voiceguard-db-writer", daemon=True)
+        self._thread.start()
+
+    def stop(self, timeout: float = 10.0) -> None:
+        """Writes what is still queued (for up to `timeout`), then closes every connection."""
+        self._stop.set()
+        if self._thread:
+            self._thread.join(timeout)
+            self._thread = None
+        with self._pool_lock:
+            pool, self._pool = self._pool, []
+        for conn in pool:
+            try:
+                conn.close()
+            except Exception:
+                pass
+        if self.settings.enabled:
+            self.state = "stopped"
+
+    def submit(self, record: CallRecord) -> bool:
+        """Queues one call for writing. Never blocks; returns False if storage is off."""
+        if not self.settings.enabled or self._stop.is_set():
+            return False
+        while self._queue.qsize() >= self.settings.queue_size:
+            try:
+                self._queue.get_nowait()
+                self._queue.task_done()
+                self.dropped += 1
+                log.warning("database queue full: dropped the oldest unsaved call")
+            except queue.Empty:
+                break
+        self._queue.put_nowait(record)
+        return True
+
+    def flush(self, timeout: float = 10.0) -> bool:
+        """Waits until everything queued so far is written (used by tests and shutdown)."""
+        deadline = time.monotonic() + timeout
+        while self._queue.unfinished_tasks and time.monotonic() < deadline:
+            time.sleep(0.01)
+        return not self._queue.unfinished_tasks
+
+    def maintain_now(self) -> dict[str, int] | None:
+        with self.connection() as conn:
+            result = repository.run_maintenance(conn, self.settings, self.clock())
+        if result is not None:
+            self.last_maintenance = {"at": self.clock(), **result}
+        return result
+
+    def status(self) -> dict[str, Any]:
+        return {
+            "state": self.state,
+            "error": self.error,
+            "queued": self._queue.qsize(),
+            "written": self.written,
+            "dropped": self.dropped,
+            "last_maintenance": self.last_maintenance,
+        }
+
+    # -- writer thread ---------------------------------------------------------------
+    def _run(self) -> None:
+        conn = None
+        backoff = 1.0
+        next_maintenance = 0.0
+        while True:
+            stopping = self._stop.is_set()
+            if stopping and not self._queue.unfinished_tasks:
+                break
+            if conn is None:
+                try:
+                    conn = self._connect()
+                    migrate(conn)
+                    self.state, self.error, backoff = "ready", None, 1.0
+                    log.info("database connected")
+                except Exception as exc:
+                    conn = None
+                    self.state, self.error = "error", f"{type(exc).__name__}: {exc}"
+                    log.warning("database unavailable (%s); retrying in %.0f s", self.error, backoff)
+                    if stopping or self._stop.wait(backoff):
+                        break
+                    backoff = min(backoff * 2, 60.0)
+                    continue
+            try:
+                if time.monotonic() >= next_maintenance:
+                    result = repository.run_maintenance(conn, self.settings, self.clock())
+                    if result is not None:
+                        self.last_maintenance = {"at": self.clock(), **result}
+                        if any(result.values()):
+                            log.info("database maintenance: %s", result)
+                    next_maintenance = time.monotonic() + self.settings.maintenance_seconds
+                batch = self._take_batch(min(1.0, max(0.0, next_maintenance - time.monotonic())))
+                if batch:
+                    try:
+                        conn = _alive(conn) or self._connect()
+                        repository.insert_records(conn, batch, self.clock())
+                        self.written += len(batch)
+                    except Exception:
+                        for record in batch:                       # put them back for the retry
+                            self._queue.put_nowait(record)
+                        raise
+                    finally:
+                        for _ in batch:
+                            self._queue.task_done()
+            except Exception as exc:
+                self.state, self.error = "error", f"{type(exc).__name__}: {exc}"
+                log.exception("database write failed; reconnecting")
+                try:
+                    conn.close()
+                except Exception:
+                    pass
+                conn = None
+                if self._stop.wait(backoff):
+                    break
+        if conn is not None:
+            try:
+                conn.close()
+            except Exception:
+                pass
+
+    def _take_batch(self, wait: float) -> list[CallRecord]:
+        try:
+            batch = [self._queue.get(timeout=wait) if wait > 0 else self._queue.get_nowait()]
+        except queue.Empty:
+            return []
+        while len(batch) < self.settings.batch_size:
+            try:
+                batch.append(self._queue.get_nowait())
+            except queue.Empty:
+                break
+        return batch
