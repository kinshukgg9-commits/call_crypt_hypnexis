# Copy to .env and run:  uvicorn backend.app:app --env-file .env
# Every value below is the default; delete what you don't change.

# Speech-to-text (faster-whisper). Use "base" or "tiny" on small instances.
WHISPER_MODEL=small
# Force a language ("hi", "en"). Empty = auto-detect: detected once per session, reused for
# LANGUAGE_RECHECK_WINDOWS windows, then re-checked (0 = detect on every window).
WHISPER_LANG=
LANGUAGE_RECHECK_WINDOWS=4
# Languages auto-detect may pick (the scam rules read English and Hindi); * = any
WHISPER_LANGUAGES=en,hi
WHISPER_COMPUTE_TYPE=int8
# 5 = beam search (more accurate, ~10% slower); 1 = greedy
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=0
TRANSCRIPTION_ENABLED=true

# Voice authenticity: onnx (no PyTorch needed) | aasist | torchscript | none
ANTISPOOF_BACKEND=onnx
# The bundled models: antideepfake-w2v-small.onnx (default; non-commercial licence) or
# aasist.onnx (MIT licence, far weaker on modern AI voices)
ANTISPOOF_ONNX=ml/models/antideepfake-w2v-small.onnx
# Only for the aasist / torchscript backends:
ANTISPOOF_CKPT=ml/weights/AASIST.pth
ANTISPOOF_MODEL_PY=ml/weights/AASIST.py
ANTISPOOF_CONFIG=ml/weights/AASIST.conf
# Which logit is "spoof" for your model (both bundled models: 0)
ANTISPOOF_SPOOF_INDEX=0
# 0 = min(4, CPU count)
TORCH_NUM_THREADS=0

# Speech detection: skip silent windows, and judge the voice only on real speech
VAD_ENABLED=true
MIN_VOICE_SPEECH_SECONDS=1.5

# The result (see backend/verdict.py)
# Scam evidence needed for "Scam call detected"
VERDICT_SCAM_THRESHOLD=0.60
# How long a scam tactic stays active after it is heard
EVIDENCE_SECONDS=120
# The voice is "AI-generated" when at least VOICE_MIN_SHARE of the speech windows score
# VOICE_THRESHOLD or more, or when any one window scores VOICE_STRONG or more
# (check on your own clips: python -m ml.evaluate)
VOICE_THRESHOLD=0.50
VOICE_MIN_SHARE=0.33
# 1.01 turns the one-window rule off; 0.50 makes any flagged window count (more false alarms)
VOICE_STRONG=0.95
# Voice windows needed before a live "AI voice" result
VERDICT_MIN_VOICE_WINDOWS=2
VERDICT_MIN_SPEECH_SECONDS=2

# Per-window risk labels
RISK_HIGH=0.70
RISK_MEDIUM=0.40

# Streaming
# Windows are WINDOW_SECONDS long at most, and may end earlier (not before
# MIN_WINDOW_SECONDS) at a pause so words aren't split
WINDOW_SECONDS=4
MIN_WINDOW_SECONDS=3
# Live voice score of the latest 4 s of audio, sent this often ("voice" messages); 0 = off
VOICE_UPDATE_SECONDS=0.5
CONTEXT_WINDOWS=6
MAX_SESSIONS=8
MAX_BACKLOG_WINDOWS=2
SESSION_IDLE_TIMEOUT=60
MAX_FRAME_BYTES=1048576
MAX_CONCURRENT_ANALYSES=1

# Uploads
MAX_UPLOAD_MB=25
MAX_UPLOAD_SECONDS=600

# Serving
PRELOAD_MODELS=true
FRONTEND_DIR=frontend
# Who may call the API from a browser. * = any site (the API has no cookies or auth).
# In production, restrict it: https://your-app.vercel.app, or https://*.vercel.app to
# include preview deployments (comma-separated). "none" disables cross-origin use.
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Advanced (rarely needed)
# cpu | cuda | auto
WHISPER_DEVICE=cpu
# Folder to keep downloaded Whisper models in (default: the Hugging Face cache)
WHISPER_DOWNLOAD_ROOT=
# Samples of audio the voice model sees per window; 0 = 4 seconds
ANTISPOOF_INPUT_SAMPLES=0
