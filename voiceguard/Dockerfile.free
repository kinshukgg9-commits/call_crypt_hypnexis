# Slim image for free hosts with 512 MB of memory (e.g. Render's free tier).
# Measured with these settings (on Windows): about 290 MB after start-up, and a peak of
# about 425 MB with two live sessions and two long uploads at once.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 app
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

RUN mkdir -p /app/.cache && chown -R app:app /app
USER app
# Smallest speech model, one thread, greedy decoding, few sessions: tuned for a small shared CPU.
# MALLOC_ARENA_MAX keeps glibc from spreading memory over one arena per thread.
ENV HF_HOME=/app/.cache/huggingface \
    WHISPER_MODEL=tiny WHISPER_BEAM_SIZE=1 WHISPER_CPU_THREADS=1 TORCH_NUM_THREADS=1 \
    ANTISPOOF_BACKEND=onnx MAX_SESSIONS=2 MAX_UPLOAD_SECONDS=120 MALLOC_ARENA_MAX=2
# Speech-to-text costs the same for 4 s as for 10 s of audio, and this CPU needs about 9 s per
# window, so long windows are what lets it keep up with a live call (measured on Render's free plan).
ENV WINDOW_SECONDS=10 MIN_WINDOW_SECONDS=7 LANGUAGE_RECHECK_WINDOWS=8
# Bake the speech model into the image so a cold start doesn't have to download it
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('tiny', device='cpu', compute_type='int8')"

COPY --chown=app:app backend ./backend
COPY --chown=app:app ml ./ml
COPY --chown=app:app frontend ./frontend

ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn backend.app:app --host 0.0.0.0 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
